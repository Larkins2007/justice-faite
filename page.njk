---
layout: base.njk
---
<article class="page-topic" data-slug="{{ slug }}">
  {% if banner %}
  <div class="page-banner" style="--banner: url('{{ banner }}')">
    <div class="page-banner-overlay"></div>
  </div>
  {% endif %}

  <header class="page-header">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1 class="page-title">{{ title }}</h1>
    {% if updated %}
    <p class="page-meta">Обновлено {{ updated | readableDate }}</p>
    {% endif %}
  </header>

  {% if short %}
  <section class="block-short" aria-label="Коротко">
    <h2 class="visually-hidden">Коротко</h2>
    <div class="short-body">
      {{ short | safe }}
    </div>
  </section>
  {% endif %}

  {% if toc %}
  <nav class="toc" aria-label="Оглавление" id="toc">
    <button type="button" class="toc-toggle" aria-expanded="false" aria-controls="toc-list">Разделы</button>
    <ol class="toc-list" id="toc-list">
      {# filled by JS or manually in content #}
    </ol>
  </nav>
  {% endif %}

  <div class="page-body prose">
    {{ content | safe }}
  </div>

  {% if related and related.length %}
  <section class="related" aria-label="См. также">
    <h2>См. также</h2>
    <ul class="related-list">
      {% for r in related %}
      <li><a href="/{{ r }}/">{{ r }}</a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="page-actions">
    <a href="{{ site.joinBot }}" class="btn btn-primary" rel="noopener" target="_blank">Вступить во флуд</a>
    <a href="{{ site.channel }}" class="btn btn-secondary" rel="noopener" target="_blank">В канал</a>
    <a href="/" class="btn btn-ghost">Все темы</a>
  </section>
</article>
